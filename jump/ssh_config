# Outbound SSH from the jump to bottles, over djinn-net's embedded DNS.
#
# accept-new, not `no`: a bottle's host keys persist on its ssh-host-keys
# volume (src/entrypoint.sh generates them there on first boot), so a first
# hop to a new bottle must be able to learn its key unattended, and a hop to
# a known bottle refuses a CHANGED key — the attack this protects against on
# a private bridge. Keys change only when the bottle is purged (down -v);
# `ssh-keygen -R <bottle>` in known_hosts after that (docs/remote.md).
Host djinn-*
    User coder
    UserKnownHostsFile /etc/djinn-jump/ssh/known_hosts
    StrictHostKeyChecking accept-new
    IdentityFile /etc/djinn-jump/ssh/id_ed25519
