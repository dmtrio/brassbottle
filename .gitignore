.DS_Store
# repo-local config + runtime home (secrets, keys, artifacts) — never commit
.env
.djinn/
# The pre-rebrand home. The code that read it is gone, but a clone predating
# the rebrand can still have this directory on disk holding real secrets —
# keep it ignored so `git add -A` there can never commit them.
.dev-agent/
secrets.env
# personal bottles carry semi-private data (private repo URLs, LAN subnets,
# identity-ref naming) — keep only the generic TEMPLATE.yml
bottles/*.yml
!bottles/TEMPLATE.yml
# generated into each container's workspace at up time (and symlinked into
# worktrees) — only visible to git when the workspace repo is this one
.mcp.json
# serena plugin's per-project state (LSP cache + agent-written memories)
.serena/
# archex plugin's per-project state (SQLite index, optional vectors, graph)
.archex/

# Python bytecode (tests / wiring module)
__pycache__/

# The golden-parity fixture is FAKE secrets by construction (its own tests
# assert the values are the *-golden-*-not-real placeholders) — carve it out
# of the bare secrets.env pattern above or the suite errors on fresh clones.
!tests/fixtures/golden/secrets.env
# Golden config snapshots intentionally include workspace/repos/.mcp.json — keep
# those fixture files tracked despite the top-level .mcp.json ignore.
!tests/fixtures/golden/configs/**/.mcp.json
!agents/*/golden/**/.mcp.json
