{
  "mcpServers": {
    "plugin-local": {
      "command": "stdio-bridge",
      "args": []
    },
    "remote-srv": {
      "command": "mcp-remote",
      "args": [
        "https://example.test/mcp",
        "--header",
        "Authorization: Bearer ${TEST_TOKEN}"
      ]
    },
    "local-srv": {
      "command": "bridge",
      "args": [
        "--stdio"
      ]
    }
  }
}
