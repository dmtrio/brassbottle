#!/bin/bash
# djinn — the word that calls them. brassbottle's CLI dispatcher.
#
# Pure glue: each subcommand execs the real implementation with the rest of
# the args forwarded verbatim. up.sh/down.sh/service.sh stay the actual
# implementations and remain runnable directly — this is just one shorter,
# memorable front door onto all of them.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

usage() {
    cat <<'EOF'
Usage: ./djinn <subcommand> [args...]
  up       <name>              create/update a container from its manifest
  down     <name> [--purge]    stop (or purge) a container
  service  <name> [args...]    start a plugin's host-side service on this Mac
  backup   <cmd> [args...]     singleton artifact backup (start/stop/status/.../browser)
  jump     <cmd> [args...]     singleton mosh jump container (start/stop/status/logs/pubkey)
  allow    --watch                  interactive egress approval watcher
  allow    <container> <domain...>  add domains to a running container's egress allowlist
  deny     <zone> (--bottle <name> | --global) [--reason "..."]   persist a deny entry
  deny     --list                                                 list deny entries
  undeny   <zone> (--bottle <name> | --global)                    remove a deny entry
  keys     <container> ...     edit one container's agent MCP credentials
  help                         show this message
EOF
}

case "${1:-}" in
    up)      shift; exec "$SCRIPT_DIR/up.sh" "$@" ;;
    down)    shift; exec "$SCRIPT_DIR/down.sh" "$@" ;;
    service) shift; exec "$SCRIPT_DIR/service.sh" "$@" ;;
    backup)  shift; exec "$SCRIPT_DIR/backup.sh" "$@" ;;
    jump)    shift; exec "$SCRIPT_DIR/jump.sh" "$@" ;;
    allow)
        shift
        if [ "${1:-}" = "--watch" ]; then
            shift
            # Source common.sh and hand the resolved home to Python in the
            # environment, exactly as backup.sh does. Without this the watcher
            # falls back to its own guess ($SCRIPT_DIR/.djinn), because the
            # Python side reads only the DJINN_HOME *variable* and never
            # ./.env — so a DJINN_HOME set there would leave the watcher
            # polling an empty queue that nothing writes to, looking perfectly
            # healthy while every container got a 401 on a token it could not
            # match. Sourced late, so the usage/error paths above stay free of
            # any ./.env dependency.
            . "$SCRIPT_DIR/src/common.sh"
            exec env DJINN_HOME="$BASE_PATH" python3 "$SCRIPT_DIR/src/egress_watch.py" "$@"
        fi
        exec "$SCRIPT_DIR/bin/allow-egress.sh" "$@"
        ;;
    deny)
        shift
        # Same DJINN_HOME resolution as `allow --watch`: source common.sh
        # late (usage/error paths stay ./.env-free) and hand BASE_PATH to
        # Python via the environment, never guessed by the Python side.
        . "$SCRIPT_DIR/src/common.sh"
        require_python3 || exit 1
        if [ "${1:-}" = "--list" ]; then
            shift
            exec env DJINN_HOME="$BASE_PATH" "$PYTHON3" "$SCRIPT_DIR/src/egress_denylist.py" list "$@"
        fi
        exec env DJINN_HOME="$BASE_PATH" "$PYTHON3" "$SCRIPT_DIR/src/egress_denylist.py" add "$@"
        ;;
    undeny)
        shift
        . "$SCRIPT_DIR/src/common.sh"
        require_python3 || exit 1
        exec env DJINN_HOME="$BASE_PATH" "$PYTHON3" "$SCRIPT_DIR/src/egress_denylist.py" remove "$@"
        ;;
    keys)    shift; exec "$SCRIPT_DIR/bin/update-agent-keys.sh" "$@" ;;
    help|-h|--help) usage; exit 0 ;;
    "")      usage >&2; exit 1 ;;
    *)       echo "Error: unknown subcommand '$1'" >&2; usage >&2; exit 1 ;;
esac
