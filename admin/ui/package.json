{
  "name": "djinn-admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:types": "tsx scripts/gen-types.ts",
    "prebuild": "npm run gen:types",
    "build": "npm run check:tokens && vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:tokens": "python3 scripts/check_tokens.py",
    "test:tokens": "cd scripts && python3 -m unittest test_check_tokens",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.2.4",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.25.0",
    "eslint-plugin-vue": "^10.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.31.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
