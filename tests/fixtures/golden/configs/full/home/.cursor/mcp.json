{
  "mcpServers": {
    "obsidian-annotated": {
      "url": "https://mcp-obsidian.dmetr.io/mcp",
      "headers": {
        "Authorization": "Bearer IDENTITY_KEY_0-golden-value"
      }
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": []
    },
    "axiom": {
      "command": "mcp-remote",
      "args": [
        "https://mcp.axiom.co/mcp",
        "--header",
        "Authorization: Bearer ${AXIOM_TOKEN}"
      ]
    }
  }
}
