{
  "mcpServers": {
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": []
    },
    "axiom": {
      "command": "mcp-remote",
      "args": [
        "https://mcp.axiom.co/mcp",
        "--header",
        "Authorization: Bearer ${AXIOM_TOKEN}"
      ]
    },
    "obsidian-annotated": {
      "command": "mcp-remote",
      "args": [
        "https://mcp-obsidian.dmetr.io/mcp",
        "--header",
        "Authorization: Bearer ${OBSIDIAN_ANNOTATED_KEY}"
      ]
    }
  }
}
